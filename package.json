{
  "name": "webapplikasjon",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:chat": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build:chat": "npm run build --workspaces",
    "test:chat": "npm run test --workspaces",
    "test:all": "npm test && npm run test:chat",
    "lint": "npm run lint -w frontend"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0",
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
